{
  "routingMode": "hybrid",
  "crossPoolRouting": true,
  "quotaFloorPercent": 10,
  "preferredPoolOrder": [
    "gemini",
    "claude",
    "gpt"
  ],
  "protectModels": [
    "argon"
  ],
  "projectAgentPrecedence": true,
  "autoResumeOnQuotaReset": true,
  "resumeBufferSeconds": 60,
  "safetyGuard": {
    "enabled": true,
    "blockHardcodedSecrets": true,
    "blockSecretWebEgress": true,
    "protectSensitiveFiles": true,
    "confirmDestructiveCommands": true
  },
  "nativeTools": {
    "useSwarmForExactThinking": true,
    "useWorkflowForFanOut": true,
    "useResearchSandbox": true,
    "useBrowserAgent": true
  }
}
