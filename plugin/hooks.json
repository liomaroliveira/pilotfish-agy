{
  "pilotfish-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|edit_file|write_file|run_command|search_web",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ANTIGRAVITY_PLUGIN_ROOT:-${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/pilotfish-agy}}/hooks/safety-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
